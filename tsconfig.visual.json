{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/visual-app/**/*.ts",
    "src/visual-app/**/*.tsx",
    "vite.visual.config.ts",
    "test/visual-workspace-state.test.ts",
    "test/visual-app-render.test.ts",
    "test/graph-canvas.test.ts",
    "test/filter-panel.test.ts",
    "test/save-view.test.ts",
    "test/graph-canvas-layout.test.ts",
    "test/changeset-tray.test.ts",
    "test/subject-form.test.ts"
  ]
}
