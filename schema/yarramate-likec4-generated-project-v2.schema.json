{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yarramate.org/schema/likec4-generated-project/v2",
  "title": "YarraMate generated multi-view LikeC4 project marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "project", "mapping", "views", "files", "digests"],
  "properties": {
    "format": {
      "const": "yarramate/likec4-generated-project/v2"
    },
    "project": {
      "$ref": "#/$defs/versionedIdentity"
    },
    "mapping": {
      "$ref": "#/$defs/versionedIdentity"
    },
    "kindMapping": {
      "$ref": "#/$defs/versionedIdentity"
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "likec4.config.json",
        "model.likec4",
        "specification.likec4"
      ],
      "properties": {
        "likec4.config.json": {
          "$ref": "#/$defs/sha256"
        },
        "model.likec4": {
          "$ref": "#/$defs/sha256"
        },
        "specification.likec4": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputDigests": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "files": {
      "const": [
        "likec4.config.json",
        "model.likec4",
        "specification.likec4"
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "versionedIdentity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+$"
    },
    "subjectIdentity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "projection": {
          "$ref": "#/$defs/versionedIdentity"
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": {
              "$ref": "#/$defs/subjectIdentity"
            },
            "to": {
              "$ref": "#/$defs/subjectIdentity"
            }
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
