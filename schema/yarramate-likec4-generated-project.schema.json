{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yarramate.org/schema/likec4-generated-project/v1",
  "title": "YarraMate generated LikeC4 project marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "projection", "mapping", "files"],
  "properties": {
    "format": {
      "const": "yarramate/likec4-generated-project/v1"
    },
    "projection": {
      "$ref": "#/$defs/versionedIdentity"
    },
    "mapping": {
      "$ref": "#/$defs/versionedIdentity"
    },
    "kindMapping": {
      "$ref": "#/$defs/versionedIdentity"
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "$ref": "#/$defs/subjectIdentity"
        },
        "to": {
          "$ref": "#/$defs/subjectIdentity"
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "likec4.config.json",
        "model.likec4",
        "specification.likec4"
      ],
      "properties": {
        "likec4.config.json": {
          "$ref": "#/$defs/sha256"
        },
        "model.likec4": {
          "$ref": "#/$defs/sha256"
        },
        "specification.likec4": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputDigests": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "files": {
      "const": [
        "likec4.config.json",
        "model.likec4",
        "specification.likec4"
      ]
    }
  },
  "$defs": {
    "versionedIdentity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+$"
    },
    "subjectIdentity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
