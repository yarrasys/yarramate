{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yarramate.org/schema/reconciliation-report/v1",
  "title": "YarraMate reconciliation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "workspace", "summary", "findings"],
  "properties": {
    "format": { "const": "yarramate/reconciliation-report/v1" },
    "workspace": { "$ref": "#/$defs/id" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceDocuments",
        "observations",
        "confirmed",
        "findings",
        "contradicted",
        "unknown",
        "notObserved",
        "subjectsWithoutEvidence"
      ],
      "properties": {
        "evidenceDocuments": { "type": "integer", "minimum": 0 },
        "observations": { "type": "integer", "minimum": 0 },
        "confirmed": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 },
        "contradicted": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "notObserved": { "type": "integer", "minimum": 0 },
        "subjectsWithoutEvidence": { "type": "integer", "minimum": 0 },
        "staleAttestations": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "unobservedSubjects": {
      "type": "array",
      "items": { "$ref": "#/$defs/subjectIdentity" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "qualifiedIdentity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*#[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:~[a-z][a-z0-9-]*)?$"
    },
    "evidenceIdentity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["subject", "claim"] },
        "id": { "$ref": "#/$defs/qualifiedIdentity" }
      }
    },
    "evidenceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "subjectIdentity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*#[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "assertedRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "$ref": "#/$defs/subjectIdentity" },
        "to": { "$ref": "#/$defs/subjectIdentity" },
        "kind": { "type": "string", "pattern": "^\\S+$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "oneOf": [
        { "$ref": "#/$defs/evidenceFinding" },
        { "$ref": "#/$defs/staleAttestationFinding" }
      ]
    },
    "evidenceFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "result",
        "provider",
        "evidenceDocument",
        "evidence"
      ],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "asserted": { "$ref": "#/$defs/assertedRelationship" },
        "result": {
          "enum": ["contradicted", "unknown", "not-observed"]
        },
        "provider": { "$ref": "#/$defs/id" },
        "evidenceDocument": { "$ref": "#/$defs/evidenceIdentity" },
        "evidence": { "$ref": "#/$defs/evidenceLocator" }
      }
    },
    "staleAttestationFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "result", "attestation", "provider", "evidence"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "subject" },
            "id": { "$ref": "#/$defs/subjectIdentity" }
          }
        },
        "result": { "const": "stale-attestation" },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topic", "by", "on"],
          "properties": {
            "topic": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "by": { "type": "string", "minLength": 1 },
            "on": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "provider": { "const": "git" },
        "changedAt": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidenceLocator" }
      }
    }
  }
}
