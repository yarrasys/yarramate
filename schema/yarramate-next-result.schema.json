{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yarramate.org/schema/next-result/v1",
  "title": "YarraMate next result",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "workspace", "projection", "subjects"],
  "properties": {
    "format": {
      "const": "yarramate/next-result/v1"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "projection": {
      "type": "string",
      "minLength": 1
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subject"
      }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "dependsOn", "requiredBy", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredBy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "$ref": "#/$defs/coverage"
        },
        "cycle": {
          "const": true
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "confirmed",
        "contradicted",
        "unknown",
        "notObserved"
      ],
      "properties": {
        "observations": { "type": "integer", "minimum": 0 },
        "confirmed": { "type": "integer", "minimum": 0 },
        "contradicted": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "notObserved": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
