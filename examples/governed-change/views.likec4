views {
  view index {
    title 'YarraMate · Governed change'
    include *
    autoLayout LeftRight
  }

  view motivation {
    title 'Motivation'
    include * where tag is #layerMotivation
    include * -> * where kind is influence
    include * -> * where kind is realization
    include * -> * where kind is association
    autoLayout LeftRight
  }

  view strategyToApplication {
    title 'Strategy to application realization'
    include * where tag is #layerStrategy
    include * where tag is #layerBusiness
    include * where tag is #layerApplication
    include * -> * where kind is realization
    include * -> * where kind is serving
    include * -> * where kind is assignment
    autoLayout LeftRight
  }

  view implementation {
    title 'Implementation and migration'
    include * where tag is #layerImplementation
    include * -> * where kind is realization
    include * -> * where kind is association
    autoLayout LeftRight
  }

  dynamic view approvalPath {
    title 'Approval path'
    variant sequence

    boardMember -> approvalInterface 'requests decision'
    approvalInterface -> controlPlane 'submits proposal'
    controlPlane -> verifyIntent 'checks current intent'

    alt {
      when 'intent matches' {
        controlPlane -> approvalDecision 'records approval'
      }
      else 'intent changed' {
        controlPlane -> boardMember 'refuses stale proposal'
      }
    }
  }
}
