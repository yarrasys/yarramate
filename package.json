{
  "name": "yarramate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/document": "./schema/yarramate-document.schema.json",
    "./schema/profile": "./schema/yarramate-profile.schema.json",
    "./schema/projection": "./schema/yarramate-projection.schema.json",
    "./schema/projection-result": "./schema/yarramate-projection-result.schema.json",
    "./schema/adapter-mapping": "./schema/yarramate-adapter-mapping.schema.json",
    "./schema/graph-v2": "./schema/yarramate-graph-v2.schema.json",
    "./schema/workspace": "./schema/yarramate-workspace.schema.json",
    "./schema/evidence": "./schema/yarramate-evidence.schema.json",
    "./schema/evidence-report": "./schema/yarramate-evidence-report.schema.json"
  },
  "bin": {
    "yarramate": "dist/cli.js"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "docs:dev": "likec4 serve examples/governed-change",
    "format": "likec4 format profile examples",
    "self:check": "pnpm build && node dist/cli.js check yarramate.workspace.yaml",
    "self:compile": "pnpm build && node dist/cli.js compile yarramate.workspace.yaml",
    "self:context": "pnpm build && node dist/cli.js context projections/current-engine.yaml yarramate.workspace.yaml",
    "self:view": "pnpm build && node dist/cli.js view projections/current-engine.yaml yarramate.workspace.yaml",
    "self:evidence": "pnpm build && node dist/cli.js evidence evidence/repository.yaml yarramate.workspace.yaml",
    "example:check": "pnpm build && node dist/cli.js check examples/governed-change/yarramate.workspace.yaml",
    "validate": "likec4 validate --no-layout examples/governed-change",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "likec4": "^1.59.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
